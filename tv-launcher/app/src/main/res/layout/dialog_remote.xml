<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="28dp">

    <ImageView
        android:id="@+id/qr"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:background="@drawable/qr_frame"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Handy als Fernbedienung"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Handy ins selbe WLAN, QR-Code mit der Kamera scannen oder im Browser öffnen:"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/acc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_close"
                style="@style/GlassButton"
                android:text="Fertig" />

            <TextView
                android:id="@+id/btn_acc"
                style="@style/GlassButton"
                android:text="Bedienungshilfe" />

            <TextView
                android:id="@+id/btn_pin"
                style="@style/GlassButton"
                android:text="Neue PIN" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
